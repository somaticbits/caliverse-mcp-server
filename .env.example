# Use `pnpm login` with these variables set once. The password is never stored.
CALIVERSE_EMAIL=
CALIVERSE_PASSWORD=

# Optional alternative to the credential file created by `pnpm login`.
# CALIVERSE_REFRESH_TOKEN=

# Required only for live mutation testing with `pnpm smoke`.
# CALIVERSE_LIVE_TEST=1
# CALIVERSE_LIVE_MUTATION_TEST=1
# CALIVERSE_TEST_LEVEL=

# Maximum UTF-8 bytes in a single MCP tool result. Defaults to 65536.
# CALIVERSE_MAX_RESULT_BYTES=65536

# Maximum bytes fetched for one exercise thumbnail. Defaults to 65536.
# CALIVERSE_MAX_IMAGE_BYTES=65536

# Maximum cumulative decoded bytes returned by an image tool. Defaults to 524288.
# CALIVERSE_MAX_IMAGE_TOTAL_BYTES=524288
