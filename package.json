{
  "name": "caliverse-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for planning, building and logging Caliverse calisthenics workouts",
  "type": "module",
  "packageManager": "pnpm@10.7.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.7.0"
  },
  "scripts": {
    "clean": "node --eval=\"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --test --experimental-test-coverage --test-coverage-include='dist/src/**' dist/test/*.test.js",
    "login": "pnpm build && node dist/scripts/login.js",
    "login:google": "pnpm build && node dist/scripts/google-login.js",
    "smoke": "pnpm build && node dist/scripts/smoke.js",
    "preview:cards": "pnpm build && node dist/scripts/preview-cards.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  }
}
